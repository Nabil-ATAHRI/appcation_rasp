[Unit]
Description=STM32 standalone Python energy gateway
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=energy
SupplementaryGroups=dialout
StateDirectory=energy-gateway
EnvironmentFile=/etc/energy-gateway.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/energy/app_rasp_ros2/src/energy_gateway
WorkingDirectory=/opt/energy/app_rasp_ros2
ExecStart=/usr/bin/python3 -m energy_gateway.gateway --serial-port=/dev/ttyAMA0 --baudrate=115200
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
